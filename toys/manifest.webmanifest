{
	"name": "Jermolene's Toys",
	"short_name": "Toys",
	"description": "Toys from jermolene.com, all in one app",
	"id": "/toys/",
	"start_url": "/toys/",
	"scope": "/toys/",
	"display": "standalone",
	"theme_color": "#5c59a7",
	"background_color": "#ffffff",
	"icons": [
		{
			"src": "icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "maskable"
		},
		{
			"src": "icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"shortcuts": [
		{
			"name": "Bear Beat",
			"description": "Animated bears dance on a light-up disco floor to the beat of whatever they hear: the microphone, a song file, a built-in groove or tapped tempo. Ten routines from the Moonwalk to the Macarena, for one to four bears",
			"url": "/toys/bear-beat/",
			"icons": [
				{
					"src": "/toys/bear-beat/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Blobbles",
			"description": "Blobs of glass at your command",
			"url": "/toys/blobbles/",
			"icons": [
				{
					"src": "/toys/blobbles/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Engravery",
			"description": "Hide a photo in a field of parallel lines, then squint to see it reappear",
			"url": "/toys/engravery/",
			"icons": [
				{
					"src": "/toys/engravery/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Flowing Field",
			"description": "An animated ink drawing of thousands of fine pen strokes sweeping into dark creased ridges. Drag to rake the strokes into line, then randomise, explore nearby drawings and cycle psychedelic colours",
			"url": "/toys/flowing-field/",
			"icons": [
				{
					"src": "/toys/flowing-field/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Fractaliser",
			"description": "A fast, smooth explorer of the Mandelbrot set and its relatives, the Tricorn, Burning Ship and Cubic Multibrot, and their Julia sets: zoom deep into them, randomise, and browse nearby variations of colour and place",
			"url": "/toys/fractaliser/",
			"icons": [
				{
					"src": "/toys/fractaliser/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Knottery",
			"description": "Draw Celtic knots freehand: strokes become woven ribbons, and a tap on a crossing flips which strand passes over",
			"url": "/toys/knottery/",
			"icons": [
				{
					"src": "/toys/knottery/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Marblelous",
			"description": "Drop inks onto a virtual marbling bath and comb them into swirling Florentine patterns",
			"url": "/toys/marblelous/",
			"icons": [
				{
					"src": "/toys/marblelous/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Mimic",
			"description": "Feed in any text and dial up the gibberish index to generate new phrases in the same style",
			"url": "/toys/mimic/",
			"icons": [
				{
					"src": "/toys/mimic/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Radialator",
			"description": "An op art explorer of radial parity patterns: rings of overlapping shapes, coloured black or white by how many of them cover each point, crossed with spokes and rings. Tweak the sliders, randomise, explore nearby patterns and download them as SVG",
			"url": "/toys/radialator/",
			"icons": [
				{
					"src": "/toys/radialator/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Rug Addict",
			"description": "Persian, Anatolian, Caucasian and Turkmen rugs generated knot by knot from the grammar of real carpets: borders, field, medallions and motifs, shown as wool pile, as a weaver's cartoon or on the floor of a room, with randomise and eight-way exploration",
			"url": "/toys/rug-addict/",
			"icons": [
				{
					"src": "/toys/rug-addict/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Spotty Sphericle",
			"description": "Thousands of dots on a spinning sphere, cube, doughnut, water drop or cloud, sized by the light falling on them: flick it, move the light, and breed new variations",
			"url": "/toys/spotty-sphericle/",
			"icons": [
				{
					"src": "/toys/spotty-sphericle/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		},
		{
			"name": "Sunthesis",
			"description": "Photorealistic sunsets computed from the physics of sunlight passing through air, haze, cloud and water: start from one of 43 real photographs, then randomise, explore nearby skies and export HDR pictures",
			"url": "/toys/sunthesis/",
			"icons": [
				{
					"src": "/toys/sunthesis/icon-192.png",
					"sizes": "192x192",
					"type": "image/png"
				}
			]
		}
	]
}
