{
	"name": "Jermolene's Toys",
	"short_name": "Toys",
	"description": "Interactive toys from jermolene.com, all in one app",
	"id": "/toys/",
	"start_url": "/toys/",
	"scope": "/toys/",
	"display": "standalone",
	"theme_color": "#5c59a7",
	"background_color": "#ffffff",
	"icons": [
		{
			"src": "icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "icon-192.png",
